{
  "name": "trilha",
  "version": "1.0.0",
  "private": true,
  "description": "Estude um vídeo, PDF ou texto: agentes de IA estudam o conteúdo e escrevem uma prova (75% para passar) com mapa de conhecimento. / Study a video, PDF or text: AI agents study the content and write a quiz (75% to pass) with a knowledge map.",
  "license": "ISC",
