    "rag",
    "knowledge-graph",
    "adhd",
    "sqlite",
    "express"
  ],
  "author": "",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "express": "^5.3.0",
    "unpdf": "^2.2.0"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
