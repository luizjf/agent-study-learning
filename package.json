    "start:pro": "node server/index.js --llm=claude-code",
    "dev": "node --watch server/index.js",
    "test": "node --test \"tests/*.test.js\"",
    "loadtest": "node scripts/loadtest.js"
  },
  "keywords": [
    "ai-agents",
    "llm",
    "claude",
